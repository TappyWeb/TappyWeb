set completed to 7

set htmx_fragments to new page with name "HTMX fragments":
    suffix: /
    stack:
        heading "HTML, on demand."
        text "Use native HTMX attributes when you need more control."
        card:
            id "stats"
            htmx "hx-get" "/stats"
            htmx "hx-trigger" "load, every 5s"
            htmx "hx-swap" "innerHTML"
            text "Loading the latest stats…"
        button "Complete a task":
            on click:
                set completed to completed + 1

fragment "Live stats" /stats
    subheading "{completed} tasks completed"
    text "This small HTML fragment comes from the C++ server."
