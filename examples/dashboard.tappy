set completed to 12
set goal to 21
set team to "Tappy team"

component Navigation:
	navigation:
		link "Overview" /
		link "Details" /details

set team_overview to new page with name "Team overview":
    suffix: /
	use Navigation
	heading "Hello, {team}."
	text "A server-rendered dashboard with a reusable navigation component."
	grid:
		card:
			subheading "Completed"
			heading "{completed}"
		card:
			subheading "Goal"
			heading "{goal}"
	if completed >= goal:
		text "Goal reached. Great work!"
	else:
		text "Keep going, one step at a time."
	button "FUCK YOU NIGGHT OWL":
		on click:
			set completed to completed + 1 # Updates state on the server.

set project_details to new page with name "Project details":
    suffix: /details
	use Navigation
	heading "A little progress every day."
	text "This example uses memory-only state. Restarting restores the initial 12 completed tasks."
